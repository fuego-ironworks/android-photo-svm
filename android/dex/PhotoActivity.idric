module PhotoActivity

-- Candidate checked Idriç -> DEX application source. The generated owner
-- is selected by the backend's generated-owner directive, not by hand-editing
-- classes.dex. No Java/Kotlin source is part of this application.
import Data.IORef
import Data.Text

%default covering

data Activity : Type where [external]
data Bundle : Type where [external]
data View : Type where [external]
data ImageView : Type where [external]
data TextView : Type where [external]
data Intent : Type where [external]
data Uri : Type where [external]
data Resolver : Type where [external]
data Stream : Type where [external]
data PhotoFile : Type where [external]
data FileInput : Type where [external]
data FileOutput : Type where [external]
