%cg dex extends Landroid/app/Activity;
%cg dex managed-field LIdric/Generated; state PhotoActivity.read_phase PhotoActivity.write_phase
%cg dex override onCreate (Landroid/os/Bundle;)V create_activity
%cg dex override before-parent onDestroy ()V destroy_activity
%cg dex override onSaveInstanceState (Landroid/os/Bundle;)V save_activity
%cg dex override onActivityResult (IILandroid/content/Intent;)V receive_picker
%cg dex callback receiver Landroid/view/View$OnClickListener; onClick (Landroid/view/View;)V receive_click
%cg dex callback receiver Landroid/view/View$OnTouchListener; onTouch (Landroid/view/View;Landroid/view/MotionEvent;)Z receive_touch

identifier : ResourceTable → Text → Text → Text → IO Int32
identifier table package kind name = primIO (resource_id table name kind package)

initialized : Activity → IO (Maybe (IORef Live))
initialized activity = do
  phase ← primIO (read_phase activity)
  current ← readIORef phase
  pure (case current of Ready cell ⇒ Just cell; Closed ⇒ Nothing)

status_text : Live → Text → IO ()
status_text state message = primIO (set_status state.controls.status message)

bind_activity : Activity → IO ()
bind_activity activity = do
  table ← primIO (resources activity)
  package ← primIO (package_name activity)
  layout ← identifier table package "layout" "activity_photo"
  primIO (set_layout activity layout)
  image_key ← identifier table package "id" "photo"
  status_key ← identifier table package "id" "status"
  pick_key ← identifier table package "id" "pick"
  organic_key ← identifier table package "id" "organic"
  inorganic_key ← identifier table package "id" "inorganic"
  image ← primIO (find_view activity image_key)
  status ← primIO (find_view activity status_key)
  let controls = Bound (as_image image) (as_text status) pick_key organic_key inorganic_key
  state ← newIORef (Running controls Nothing)
  phase ← newIORef (Ready state)
  primIO (write_phase activity phase)
  for_ [pick_key, organic_key, inorganic_key] (\key ⇒ do
    button ← primIO (find_view activity key)
    primIO (on_click button (click_listener activity)))
  -- A clickable ImageView consumes ACTION_DOWN so ACTION_UP reaches the
  -- listener; merely registering OnTouchListener is insufficient.
  primIO (set_clickable image 1)
  primIO (on_touch image (touch_listener activity))
  primIO (set_status (as_text status) "Choose a JPEG or PNG up to 1,048,576 pixels")

-- A new overlay is published only after native completion and Bitmap creation.
-- The previous Bitmap stays visible on native failure.
show_frame : Live → Frame → IO Bool
show_frame state frame = do
  let pixel_count = frame.width * frame.height
  if frame.width <= 0 || frame.height <= 0 ||
     frame.width > 4096 || frame.height > 4096 || pixel_count > 1048576
    then pure False
    else do
      buffer ← primIO (allocate_pixels pixel_count)
      output ← primIO (backing_array buffer)
      status ← primIO (overlay frame.handle output)
      if status /= 0 then pure False else do
        format ← primIO (bitmap_format "ARGB_8888")
        bitmap ← primIO (bitmap_from_pixels output frame.width frame.height format)
        primIO (set_bitmap state.controls.image bitmap)
        pure True

image_preferences : Activity → Int64 → IO Preferences
image_preferences activity handle = do
  first ← primIO (image_key_part handle 0)
  second ← primIO (image_key_part handle 1)
  third ← primIO (image_key_part handle 2)
  fourth ← primIO (image_key_part handle 3)
  let digest = hex_word first ++ "-" ++ hex_word second ++ "-" ++
               hex_word third ++ "-" ++ hex_word fourth
  primIO (private_preferences activity ("photo-regions-v1-" ++ digest) 0)

restore_corrections : Preferences → Int64 → Int32 → Int32 → IO Bool
restore_corrections preferences handle region count =
  if region >= count then pure True else do
    label ← primIO (read_label preferences (region_key region) 0)
    if label == 0 then restore_corrections preferences handle (region + 1) count
      else if label /= 1 && label /= 2 then pure False else do
        outcome ← primIO (assert_region handle region label)
        if outcome == 0 then restore_corrections preferences handle (region + 1) count
          else pure False

save_correction : Live → Frame → Int32 → Int32 → IO ()
save_correction state frame region label =
  primIO (protect (do
    if region < 0 || region >= frame.count then status_text state "Stale region selection"
      else do
        editor ← primIO (edit_labels frame.correction_store)
        updated ← primIO (write_label editor (region_key region) label)
        committed ← primIO (commit_labels updated)
        if committed == 0 then status_text state "Could not save region correction"
          else do
            result ← primIO (assert_region frame.handle region label)
            visible ← if result == 0 then show_frame state frame else pure False
            status_text state (if visible then "Saved human assertion"
              else "Correction saved. Reopen the image to refresh the overlay"))
    (\_ ⇒ status_text state "Could not complete correction"))

process_bitmap : Activity → Uri → Bitmap → Int32 → Int32 → Int32 → IO ()
process_bitmap activity uri bitmap width height orientation = do
  cell ← initialized activity
  case cell of
    Nothing ⇒ pure ()
    Just current ⇒ do
      state ← readIORef current
      source_buffer ← primIO (allocate_pixels (width * height))
      source ← primIO (backing_array source_buffer)
      primIO (get_pixels bitmap source 0 width 0 0 width height)
      handle ← primIO (ingest width height width orientation source)
      if handle == 0 then status_text state "Native frame rejected" else do
        accepted ← newIORef False
        primIO (always (do
          dw ← primIO (frame_width handle)
          dh ← primIO (frame_height handle)
          count ← primIO (region_count handle)
          preferences ← image_preferences activity handle
          let frame = Accepted handle dw dh preferences count uri Nothing
          restored ← restore_corrections preferences handle 0 count
          visible ← if restored then show_frame state frame else pure False
          if visible
            then do
              writeIORef current ({ current := Just frame } state)
              writeIORef accepted True
              case state.current of
                Nothing ⇒ pure ()
                Just old ⇒ do
                  _ ← primIO (cancel old.handle)
                  _ ← primIO (release old.handle)
                  pure ()
              status_text state "Green: organic. Cyan: inorganic. Unshaded: unknown."
            else status_text state "No overlay published")
          (do kept ← readIORef accepted
              if kept then pure () else do
                _ ← primIO (release handle)
                pure ()))

decode_photo : Activity → Uri → Text → Int32 → IO ()
decode_photo activity uri path orientation = do
  decoder ← primIO (new_decoder path 0)
  if is_null (decoder_object decoder) == 1 then pure () else
    primIO (always (do
      width ← primIO (decode_width decoder)
      height ← primIO (decode_height decoder)
      if width <= 0 || height <= 0 ||
         width > 4096 || height > 4096 || width * height > 1048576
        then do
          Just cell ← initialized activity | Nothing ⇒ pure ()
          state ← readIORef cell
          status_text state "Refused: image exceeds bounded decode limit"
        else do
          area ← primIO (rectangle 0 0 width height)
          options ← primIO new_options
          bitmap ← primIO (decode_region decoder area options)
          if is_null (bitmap_object bitmap) == 1 then pure () else
            primIO (always (process_bitmap activity uri bitmap width height orientation)
                           (primIO (recycle_bitmap bitmap))))
      (primIO (recycle_decoder decoder)))

staging_chunk_size : Int32
staging_chunk_size = 65536

staging_limit : Int32
staging_limit = 16777216

write_staged_chunk : WriteChannel → ByteBuffer → Int32 → IO Bool
write_staged_chunk sink buffer remaining =
  if remaining == 0 then pure True else do
    count ← primIO (write_chunk sink buffer)
    if count <= 0 || count > remaining then pure False
      else write_staged_chunk sink buffer (remaining - count)

copy_encoded_photo : ReadChannel → WriteChannel → ByteBuffer → Int32 → IO Bool
copy_encoded_photo source sink buffer remaining = do
  _ ← primIO (clear_bytes (base_buffer buffer))
  count ← primIO (read_chunk source buffer)
  if count == (-1) then pure True
    else if count <= 0 || count > staging_chunk_size || count > remaining then pure False
    else do
      _ ← primIO (flip_bytes (base_buffer buffer))
      written ← write_staged_chunk sink buffer count
      if written then copy_encoded_photo source sink buffer (remaining - count)
        else pure False

show_status : Activity → Text → IO ()
show_status activity message = do
  Just cell ← initialized activity | Nothing ⇒ pure ()
  state ← readIORef cell
  status_text state message

-- Check the file signature before using the API 23 JPEG-only EXIF reader.
-- A second InputStream from the URI could return a different provider object.
read_orientation : PhotoFile → Text → IORef Int32 → IO ()
read_orientation staged path orientation = do
  input ← primIO (open_staging_input staged)
  primIO (always (do
    first ← primIO (read_header_byte input)
    second ← primIO (read_header_byte input)
    if first == 255 && second == 216 then do
      metadata ← primIO (read_jpeg_metadata path)
      tag ← primIO (metadata_tag metadata "Orientation" 0)
      writeIORef orientation (if tag == 0 then 1 else tag)
      else if first == 137 && second == 80 then do
        third ← primIO (read_header_byte input)
        fourth ← primIO (read_header_byte input)
        fifth ← primIO (read_header_byte input)
        sixth ← primIO (read_header_byte input)
        seventh ← primIO (read_header_byte input)
        eighth ← primIO (read_header_byte input)
        if third == 78 && fourth == 71 && fifth == 13 && sixth == 10 &&
           seventh == 26 && eighth == 10 then writeIORef orientation 1 else pure ()
      else pure ()) (primIO (close_staging_input input)))

stage_and_decode : Activity → Uri → Stream → PhotoFile → IO ()
stage_and_decode activity uri source staged = do
  copied ← newIORef False
  sink ← primIO (open_staging_output staged)
  primIO (always (do
    buffer ← primIO (allocate_bytes staging_chunk_size)
    reader ← primIO (staging_source source)
    writer ← primIO (staging_sink sink)
    complete ← copy_encoded_photo reader writer buffer staging_limit
    writeIORef copied complete) (primIO (close_staging_output sink)))
  completed ← readIORef copied
  if completed
    then do
      path ← primIO (file_path staged)
      orientation ← newIORef 0
      read_orientation staged path orientation
      value ← readIORef orientation
      if value < 1 || value > 8 then show_status activity "Unsupported image or orientation"
        else decode_photo activity uri path value
    else show_status activity "Encoded image exceeds 16 MiB or the stream stopped"

load_photo : Activity → Uri → IO ()
load_photo activity uri = do
  resolver ← primIO (content_resolver activity)
  directory ← primIO (cache_directory activity)
  staged ← primIO (new_staged_file "photo-" ".stage" directory)
  primIO (always (do
    stream ← primIO (open_stream resolver uri)
    if is_null (stream_object stream) == 1 then show_status activity "Could not open image"
      else primIO (always (stage_and_decode activity uri stream staged) (primIO (close_stream stream))))
    (do _ ← primIO (delete_file staged)
        pure ()))

report_failure : Activity → Throwable → IO ()
report_failure activity failure = do
  maybe_cell ← initialized activity
  case maybe_cell of
    Nothing ⇒ pure ()
    Just cell ⇒ do
      state ← readIORef cell
      description ← primIO (error_text failure)
      status_text state ("Image failed: " ++ description)

%export "dex:create_activity"
create_activity : Activity → Bundle → IO ()
create_activity activity saved = do
  bind_activity activity
  if is_null (bundle_object saved) == 1 then pure () else do
    path ← primIO (read_saved_uri saved "active-photo" "")
    if path == "" then pure () else do
      uri ← primIO (parse_uri path)
      primIO (protect (load_photo activity uri) (report_failure activity))

%export "dex:save_activity"
save_activity : Activity → Bundle → IO ()
save_activity activity saved = do
  Just cell ← initialized activity | Nothing ⇒ pure ()
  state ← readIORef cell
  case state.current of
    Nothing ⇒ pure ()
    Just frame ⇒ do
      path ← primIO (uri_text frame.original_uri)
      primIO (write_saved_uri saved "active-photo" path)

%export "dex:receive_picker"
receive_picker : Activity → Int32 → Int32 → Intent → IO ()
receive_picker activity request result intent =
  if request /= 7 || result /= (-1) || is_null (intent_object intent) == 1
    then pure () -- canceled or unrelated: retain the prior frame
    else do
      uri ← primIO (picked_uri intent)
      if is_null (uri_object uri) == 1 then pure () else
        primIO (protect (load_photo activity uri) (report_failure activity))

%export "dex:receive_click"
receive_click : Activity → View → IO ()
receive_click activity view = do
  maybe_cell ← initialized activity
  case maybe_cell of
    Nothing ⇒ pure ()
    Just cell ⇒ do
      state ← readIORef cell
      selected_button ← primIO (view_id view)
      if selected_button == state.controls.pick_id
        then do
          intent ← primIO (new_intent "android.intent.action.OPEN_DOCUMENT")
          _ ← primIO (add_category intent "android.intent.category.OPENABLE")
          _ ← primIO (set_type intent "image/*")
          primIO (open_picker activity intent 7)
        else case state.current of
          Nothing ⇒ pure ()
          Just frame ⇒ case frame.selected of
            Nothing ⇒ status_text state "Tap a region before assigning a label"
            Just selected ⇒ do
              let label = if selected_button == state.controls.organic_id then 1
                            else if selected_button == state.controls.inorganic_id then 2
                            else 0
              if label == 0 then pure () else save_correction state frame selected label

%export "dex:receive_touch"
receive_touch : Activity → View → MotionEvent → IO Bool
receive_touch activity view motion = do
  action ← primIO (motion_action motion)
  if action /= 1 then pure False else do
    maybe_cell ← initialized activity
    case maybe_cell of
      Nothing ⇒ pure False
      Just cell ⇒ do
        state ← readIORef cell
        case state.current of
          Nothing ⇒ pure False
          Just frame ⇒ do
            width ← primIO (view_width view)
            height ← primIO (view_height view)
            x ← primIO (motion_x motion)
            y ← primIO (motion_y motion)
            id ← primIO (region_at_view frame.handle width height
                              (round_pixel x) (round_pixel y))
            if id < 0 then pure False else do
              writeIORef cell ({ current := Just ({ selected := Just id } frame) } state)
              status_text state ("Region " ++ cast id ++ ": choose Organic or Inorganic")
              pure True

%export "dex:destroy_activity"
destroy_activity : Activity → IO ()
destroy_activity activity = primIO (protect (do
  phase ← primIO (read_phase activity)
  previous ← readIORef phase
  writeIORef phase Closed
  case previous of
    Closed ⇒ pure ()
    Ready cell ⇒ do
      state ← readIORef cell
      case state.current of
        Nothing ⇒ pure ()
        Just frame ⇒ do
          _ ← primIO (cancel frame.handle)
          _ ← primIO (release frame.handle)
          pure ()) (\_ ⇒ pure ()))

main : IO ()
main = pure ()
