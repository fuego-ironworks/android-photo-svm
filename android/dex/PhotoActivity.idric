data StageBuffer : Type where [external]
data ReadChannel : Type where [external]
data WriteChannel : Type where [external]
data PhotoMetadata : Type where [external]
data Preferences : Type where [external]
data Editor : Type where [external]
data RegionDecoder : Type where [external]
data Rectangle : Type where [external]
data DecodeOptions : Type where [external]
data Bitmap : Type where [external]
data BitmapConfig : Type where [external]
data IntBuffer : Type where [external]
data PixelArray : Type where [external]
data ResourceTable : Type where [external]
data Object : Type where [external]
data ClickListener : Type where [external]
data TouchListener : Type where [external]
data MotionEvent : Type where [external]
data CoordinateFloat : Type where [external]
data Throwable : Type where [external]

record Controls where
  constructor Bound
  image : ImageView
  status : TextView
  pick_id : Int32
  organic_id : Int32
  inorganic_id : Int32

record Frame where
  constructor Accepted
  handle : Int64
  width : Int32
  height : Int32
  correction_store : Preferences
  count : Int32
  original_uri : Uri
  selected : Maybe Int32

record Live where
  constructor Running
  controls : Controls
  current : Maybe Frame

data Phase = Ready (IORef Live) | Closed

%extern
read_phase : Activity → PrimIO (IORef Phase)
%extern
write_phase : Activity → IORef Phase → PrimIO ()

