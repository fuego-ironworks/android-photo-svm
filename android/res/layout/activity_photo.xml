<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#17191d">
  <Button android:id="@+id/pick" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="Choose photograph" />
  <ImageView android:id="@+id/photo" android:layout_width="match_parent"
      android:layout_height="0dp" android:layout_weight="1"
      android:scaleType="fitCenter" android:contentDescription="Segmentation overlay"
      android:layout_gravity="center" />
  <TextView android:id="@+id/status" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:textColor="#efefef"
      android:minHeight="50dp" android:padding="12dp"
      android:text="No photo selected" />
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
      android:layout_height="wrap_content">
    <Button android:id="@+id/organic" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Mark organic" />
    <Button android:id="@+id/inorganic" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Mark inorganic" />
  </LinearLayout>
</LinearLayout>
